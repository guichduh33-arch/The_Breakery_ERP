{
  "name": "the-breakery",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:start": "echo \"Docker retiré 2026-05-14 — DB = Supabase cloud V3 (cf CLAUDE.md §DB workflow)\" && exit 1",
    "db:stop": "echo \"Docker retiré 2026-05-14 — DB = Supabase cloud V3 (cf CLAUDE.md §DB workflow)\" && exit 1",
    "db:reset": "echo \"Docker retiré 2026-05-14 — DB = Supabase cloud V3 (cf CLAUDE.md §DB workflow)\" && exit 1",
    "db:types": "supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" --schema public > packages/supabase/src/types.generated.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript@<7.0.5": ">=7.0.5",
      "fast-uri@<3.1.2": ">=3.1.2",
      "@babel/plugin-transform-modules-systemjs@<7.29.4": ">=7.29.4",
      "@babel/core@<7.29.6": ">=7.29.6",
      "esbuild@<0.25.0": ">=0.25.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "brace-expansion@<1.1.16": ">=1.1.16 <2",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2 <3",
      "brace-expansion@>=5.0.0 <5.0.8": ">=5.0.8",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0 <5",
      "body-parser@<1.20.6": ">=1.20.6 <2",
      "ws@<8.20.1": ">=8.20.1",
      "vite@<6.4.3": ">=6.4.3 <7"
    }
  }
}
