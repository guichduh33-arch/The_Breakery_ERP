{
  "projectId": "d8a51f53-5452-4117-88d9-9b6b357f588e",
  "shape": "package",
  "pkg": "@breakery/ui",
  "globalName": "BreakeryUI",
  "readmeHeader": ".design-sync/conventions.md",
  "extraEntries": ["sonner"],
  "buildCmd": "./packages/ui/node_modules/.bin/tailwindcss -c .design-sync/tailwind.config.ts -i .design-sync/tailwind.entry.css -o packages/ui/.ds-tailwind.css --minify",
  "cssEntry": ".ds-tailwind.css",
  "tokensGlob": "src/tokens/*.css",
  "overrides": {
    "BrandMark": { "cardMode": "column" },
    "ComboLineRow": { "cardMode": "column" },
    "IngredientPicker": { "cardMode": "column" },
    "PromotionForm": { "cardMode": "column" },
    "PromotionLineRow": { "cardMode": "column" },
    "QwertyLayout": { "cardMode": "column" },
    "RefundLineRow": { "cardMode": "column" },
    "RefundTenderSplitter": { "cardMode": "column" },
    "Stat": { "cardMode": "column" },
    "TabletInboxRow": { "cardMode": "column" },
    "TabletOrderCard": { "cardMode": "column" },
    "ScrollArea": { "cardMode": "column" },
    "Tabs": { "cardMode": "column" },
    "VirtualKeypadProvider": { "cardMode": "single", "primaryStory": "NumpadOuvert" },
    "Dialog": { "cardMode": "single", "viewport": "800x640" },
    "Sheet": { "cardMode": "single", "viewport": "800x640" },
    "CenterModal": { "cardMode": "single", "viewport": "800x640" },
    "FullScreenModal": { "cardMode": "single", "viewport": "1024x768" },
    "ModifierModal": { "cardMode": "single", "viewport": "800x700" },
    "CustomerSearchModal": { "cardMode": "single", "viewport": "800x640" },
    "TableSelectorModal": { "cardMode": "single", "viewport": "800x640" },
    "HeldOrdersModal": { "cardMode": "single", "viewport": "800x640" },
    "PinVerificationModal": { "cardMode": "single", "viewport": "800x700" },
    "DiscountModal": { "cardMode": "single", "viewport": "800x700" },
    "RedeemPointsModal": { "cardMode": "single", "viewport": "800x700" },
    "RefundReceiptModal": { "cardMode": "single", "viewport": "800x700" }
  },
  "extraFonts": [
    "../../apps/backoffice/node_modules/@fontsource-variable/instrument-sans/index.css",
    "../../apps/pos/node_modules/@fontsource-variable/inter/index.css",
    "../../apps/pos/node_modules/@fontsource-variable/jetbrains-mono/index.css",
    "../../apps/pos/node_modules/@fontsource/playfair-display/400.css",
    "../../apps/pos/node_modules/@fontsource/playfair-display/400-italic.css",
    "../../apps/pos/node_modules/@fontsource/playfair-display/600.css",
    "../../apps/pos/node_modules/@fontsource/playfair-display/700.css"
  ]
}
