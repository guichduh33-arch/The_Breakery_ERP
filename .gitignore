# Print-bridge hub ring-buffer (spec 006x lot 1) — journal JSONL runtime,
# nom par défaut de HUB_BUFFER_FILE (config.ts)
apps/print-bridge/hub-buffer.jsonl

# Ruflo / claude-flow swarm runtime
.claude-flow/
.swarm/
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json
# Serveurs de dev de l'aperçu intégré. Partagé : les ports sont déjà figés dans
# les vite.config.ts et les scripts `dev`, un poste cloné n'a donc rien à régler.
!.claude/launch.json
.claude/agents/*/
# skill-creator eval/optimize scratch dirs — never commit
.claude/skills/*-workspace/

# Impeccable — état par machine (consentement local du hook, cache de dédup).
# La config partagée (.impeccable/config.json) et les snapshots de critique, eux,
# sont versionnés.
.impeccable/config.local.json
.impeccable/hook.cache.json
ruvector.db
*.ruvector.db

outputs/

# design-sync (claude.ai/design) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
packages/ui/.ds-tailwind.css
